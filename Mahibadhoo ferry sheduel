<!DOCTYPE html>
<html lang="dv" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>މަހިބަދޫ ދަތުރުފަތުރުގެ ގަޑިތައް</title>
    <style>
        body {
            font-family: "Tharaa", "MV Faseyha", Arial, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }
        h1 {
            text-align: center;
            color: #0077b6;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .transport-card {
            background: #f9f9f9;
            border-right: 5px solid #0077b6;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .transport-card.cargo {
            border-right-color: #e76f51;
        }
        .transport-title {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 8px;
            color: #2b2d42;
        }
        .schedule-info {
            font-size: 15px;
            color: #555;
            margin: 5px 0;
        }
        .tag {
            display: inline-block;
            padding: 3px 8px;
            font-size: 12px;
            border-radius: 4px;
            background: #e0f2fe;
            color: #0369a1;
            margin-left: 5px;
        }
        .cargo .tag {
            background: #ffe4e6;
            color: #9f1239;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>މަހިބަދޫ - މާލެ ދަތުރުފަތުރު</h1>

    <!-- އެޗް އެމް އެޗް އައި ސްޕީޑް -->
    <div class="transport-card">
        <div class="transport-title">އެޗް އެމް އެޗް އައި ސްޕީޑް <span class="tag">ސްޕީޑްބޯޓް</span></div>
        <div class="schedule-info">🚢 މަހިބަދޫ އިން ފުރާ ގަޑި: <strong>07:00</strong></div>
        <div class="schedule-info">🏙️ މާލެ އިން ފުރާ ގަޑި: <strong>16:00</strong></div>
    </div>

    <!-- މައިނާ ސްޕީޑް -->
    <div class="transport-card">
        <div class="transport-title">މައިނާ ސްޕީޑް <span class="tag">ސްޕީޑްބޯޓް</span></div>
        <div class="schedule-info">🚢 މަހިބަދޫ އިން ފުރާ ގަޑި: <strong>07:00</strong></div>
        <div class="schedule-info">🏙️ މާލެ އިން ފުރާ ގަޑި: <strong>16:00</strong></div>
    </div>

    <!-- ވެރޯނާ ކާގޯ ބޯޓް -->
    <div class="transport-card cargo">
        <div class="transport-title">ވެރޯނާ ކާގޯ ބޯޓް <span class="tag">ކާގޯ</span></div>
        <div class="schedule-info">🚢 މަހިބަދޫ އިން ފުރާ ގަޑި: <strong>02:30</strong></div>
        <div class="schedule-info">🏙️ މާލެ އިން ފުރާ ގަޑި: <strong>14:30</strong></div>
    </div>

    <!-- ހައިޝަމް ކާގޯ ބޯޓް -->
    <div class="transport-card cargo">
        <div class="transport-title">ހައިޝަމް ކާގޯ ބޯޓް <span class="tag">ކާގޯ</span></div>
        <div class="schedule-info">🚢 މަހިބަދޫ އިން ފުރާ ގަޑި: <strong>02:30</strong></div>
        <div class="schedule-info">🏙️ މާލެ އިން ފުރާ ގަޑި: <strong>14:30</strong></div>
    </div>

</div>

</body>
</html>

